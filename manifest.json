{
"manifest_version":2,
"name":"DOM XSS detector",
"description":"This extensions scans for vulnerable elements on the web page to prevent DOM XSS, some features on the web page may break,",
"version":"1.0",

"icons":{
    "32": "images/coin.png"
},

"permissions":[ 
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "management",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "storage"

],

"content_scripts": [
    {
        "matches":["<all_urls>"],
        "js":[
        "javascript/purify.min.js",
        "javascript/tensorflow.js",
        "javascript/sourceFinder&Prevention.js",
        "javascript/popUp.js",
        "javascript/getDataSets.js",
        "javascript/ai_model_detection.js"
      ]
    }
],

"browser_specific_settings": {
  "gecko": {
    "id": "sample@example.com"
  }
},
"background": {
    "scripts": ["background.js"],
    "persistent": true
},

"browser_action": {
  "default_icon":"images/coin.png",
  "default-title":"Extension",
  "default_popup": "interface.html"
}
}
